rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's own tree: the user document (activeListId), preferences/main, and the legacy
    // personal items (read once to migrate them into lists/{uid}).
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /preferences/{preferencesId} {
        allow read, write: if isOwner(uid);
      }

      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidItem(request.resource.data, itemId);
      }
    }

    // A list's ID is its owner's uid. Members share its items.
    match /lists/{listId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isOwner(listId)
        && request.resource.data.keys().hasOnly(['ownerId', 'memberIds'])
        && request.resource.data.ownerId == listId
        && request.resource.data.memberIds == [listId];
      allow update: if isSignedIn() && (isOwnerUpdate() || isLeaving() || isJoining(listId));
      // Only with the owner's account. Its members then fail isListMember and go back to their own lists.
      allow delete: if isOwner(listId);

      // Items must match GroceryItem's Codable keys (pinned in ModelKeysTests.swift).
      // The owner (listId == uid) needs no lookup. That also lets the migration batch create the
      // list and its items together: in a batch, get() still sees the list as missing.
      match /items/{itemId} {
        allow read, delete: if isOwner(listId) || isListMember(listId);
        allow create, update: if (isOwner(listId) || isListMember(listId))
          && isValidItem(request.resource.data, itemId)
          && isHonestCompletedBy();
      }
    }

    // Invite codes: fetched by code. The only query allowed is for your own (account deletion removes them).
    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['listId', 'createdBy', 'expiresAt'])
        && request.resource.data.listId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isListMember(listId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberIds;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The owner may change the members, but stays the owner and a member. They may also remove a
    // joinCode that older app versions stored on the list, but never add or change one.
    function isOwnerUpdate() {
      let diff = request.resource.data.diff(resource.data);
      return request.auth.uid == resource.data.ownerId
        && diff.addedKeys().union(diff.changedKeys()).hasOnly(['memberIds'])
        && diff.removedKeys().hasOnly(['joinCode'])
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 10;
    }

    // A member other than the owner removes only themselves.
    function isLeaving() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      return request.auth.uid in before
        && request.auth.uid != resource.data.ownerId
        && onlyChanged(['memberIds'])
        && after.size() == before.size() - 1
        && after.toSet() == before.toSet().difference([request.auth.uid].toSet());
    }

    // A non-member adds only themselves. The proof of invite is the joinCode in their own users/{uid}
    // document, written in the same batch (getAfter sees it): it must name an unexpired invite for
    // this list. Nothing on the list itself counts, so a joinCode left there by older app versions
    // lets nobody in.
    function isJoining(listId) {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      let code = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinCode;
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return !(request.auth.uid in before)
        && onlyChanged(['memberIds'])
        && after.size() == before.size() + 1
        && after.size() <= 10
        && after.toSet() == before.toSet().union([request.auth.uid].toSet())
        && code is string
        && invite.listId == listId
        && invite.expiresAt > request.time;
    }

    // completedBy says who checked an item off, which decides whose unload reminder it counts for.
    // A writer may set it only to themselves or clear it; someone else's stays as it was.
    function isHonestCompletedBy() {
      let data = request.resource.data;
      return !('completedBy' in data)
        || data.completedBy == request.auth.uid
        || (resource != null && 'completedBy' in resource.data && data.completedBy == resource.data.completedBy);
    }

    function isValidItem(data, itemId) {
      return data.keys().hasOnly(['id', 'title', 'notes', 'aisle', 'isCompleted', 'completedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'title', 'isCompleted', 'createdAt', 'updatedAt'])
        && data.id == itemId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('aisle' in data) || (data.aisle is string && data.aisle.size() <= 200))
        && (!('completedBy' in data) || (data.completedBy is string && data.completedBy.size() <= 128))
        && data.isCompleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
  }
}
