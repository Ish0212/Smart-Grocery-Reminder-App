rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own users/{uid} tree
    // (the user document, items/{itemId} and preferences/main). Everything else is denied.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
