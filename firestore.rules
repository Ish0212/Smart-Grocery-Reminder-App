rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own users/{uid} tree:
    // the user document, preferences/main and items/{itemId}. Everything else is denied.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /preferences/{preferencesId} {
        allow read, write: if isOwner(uid);
      }

      // Items must match GroceryItem's Codable keys (pinned in ModelKeysTests.swift).
      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidItem(request.resource.data, itemId);
      }
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidItem(data, itemId) {
      return data.keys().hasOnly(['id', 'title', 'notes', 'aisle', 'isCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'title', 'isCompleted'])
        && data.id == itemId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('aisle' in data) || (data.aisle is string && data.aisle.size() <= 200))
        && data.isCompleted is bool;
    }
  }
}
